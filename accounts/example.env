# Copy this file OUTSIDE the repository to:
# ~/.threads-operator/accounts/<account-key>.env

THREADS_ACCESS_TOKEN=replace_me
THREADS_USER_ID=replace_me
THREADS_API_BASE_URL=https://graph.threads.net/v1.0

SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

THREADS_ACCOUNT_SAMPLE_MINUTES=15

# One persistent authenticated browser profile per Threads account.
THREADS_BROWSER_PROFILE=~/.threads-operator/browser-profiles/example
ACTIVITY_FOLLOW_COLLECTOR_ENABLED=false

# Safe publishing defaults. Both values must explicitly opt in for live posting.
THREADS_POSTING_ENABLED=false
THREADS_EXECUTION_MODE=approval_required
THREADS_QUEUE_TABLE=threads_publish_queue
# Optional campaign filter for the publish queue. Leave EMPTY (as below) to
# publish ANY due approved row for this account — recommended for a generic
# pipeline that serves all campaigns. Set a code (e.g. MARKETING_COURSE_AFFILIATE)
# only to restrict the worker to one campaign.
THREADS_QUEUE_CAMPAIGN_CODE=

# Engagement actions use a separate live kill-switch. Reply execution also
# requires an explicit pending_approval -> approved transition.
THREADS_ENGAGEMENT_ENABLED=false
